<Window x:Class="PdfEditor.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PdfEditor.Desktop.ViewModels"
        Title="{Binding WindowTitle}" Height="900" Width="1400"
        MinHeight="650" MinWidth="1000"
        Background="{StaticResource AppBackground}"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">
    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenCommand}"/>
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveAsCommand}"/>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}"/>
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}"/>
        <KeyBinding Key="PageUp" Command="{Binding PreviousPageCommand}"/>
        <KeyBinding Key="PageDown" Command="{Binding NextPageCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#DCE1EA" BorderThickness="0,0,0,1" Padding="8">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="Open PDF" Command="{Binding OpenCommand}"/>
                    <Button Content="Save As" Command="{Binding SaveAsCommand}"/>
                    <Separator Margin="8,0"/>
                    <Button Content="Undo" Command="{Binding UndoCommand}"/>
                    <Button Content="Redo" Command="{Binding RedoCommand}"/>
                    <Separator Margin="8,0"/>
                    <Button Content="◀" Command="{Binding PreviousPageCommand}"/>
                    <TextBlock Text="{Binding PageDisplay}" VerticalAlignment="Center" Margin="8,0" FontWeight="SemiBold"/>
                    <Button Content="▶" Command="{Binding NextPageCommand}"/>
                    <Separator Margin="8,0"/>
                    <Button Content="−" Command="{Binding ZoomOutCommand}" FontSize="18"/>
                    <TextBlock Text="{Binding ZoomDisplay}" VerticalAlignment="Center" MinWidth="58" TextAlignment="Center"/>
                    <Button Content="+" Command="{Binding ZoomInCommand}" FontSize="16"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Right" Text="Double-click highlighted text to edit" VerticalAlignment="Center" Margin="18,0" Foreground="#536078"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="28" Background="#E9EDF3">
                <Border Background="White" BorderBrush="#C5CBD6" BorderThickness="1"
                        Width="{Binding PageWidth}" Height="{Binding PageHeight}" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Grid Width="{Binding PageWidth}" Height="{Binding PageHeight}">
                        <Image Source="{Binding PageImage}" Stretch="Fill" Width="{Binding PageWidth}" Height="{Binding PageHeight}"/>
                        <ItemsControl ItemsSource="{Binding Regions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                                    <Setter Property="Canvas.Top" Value="{Binding Top}"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:TextRegionViewModel}">
                                    <Grid Width="{Binding Width}" Height="{Binding OverlayHeight}">
                                        <Border x:Name="RegionBorder" Background="#08FFFFFF" BorderBrush="#55246BFD" BorderThickness="1"
                                                Height="{Binding Height}" VerticalAlignment="Top"
                                                MouseLeftButtonDown="RegionBorder_MouseLeftButtonDown" Cursor="IBeam" ToolTip="Double-click to edit">
                                            <TextBlock Text=""/>
                                        </Border>
                                        <Border Background="White" BorderBrush="#246BFD" BorderThickness="1" IsHitTestVisible="False"
                                                Height="{Binding OverlayHeight}" VerticalAlignment="Top">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding IsModified}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding IsEditing}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding DisplayText}" TextTrimming="CharacterEllipsis"
                                                       FontFamily="{Binding FontFamily}" FontSize="{Binding DisplayFontSize}"
                                                       FontWeight="{Binding DisplayFontWeight}" FontStyle="{Binding DisplayFontStyle}"
                                                       Foreground="#182033" VerticalAlignment="Top"/>
                                        </Border>
                                        <TextBox x:Name="InlineEditor" Text="{Binding DraftText, UpdateSourceTrigger=PropertyChanged}"
                                                 FontFamily="{Binding FontFamily}" FontSize="{Binding DisplayFontSize}"
                                                 FontWeight="{Binding DisplayFontWeight}" FontStyle="{Binding DisplayFontStyle}"
                                                 Height="{Binding OverlayHeight}" VerticalAlignment="Top"
                                                 Background="White" BorderBrush="#246BFD" BorderThickness="2"
                                                 Padding="1" AcceptsReturn="True" TextWrapping="NoWrap"
                                                 KeyDown="InlineEditor_KeyDown" LostKeyboardFocus="InlineEditor_LostKeyboardFocus">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEditing}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
            </ScrollViewer>

            <Border Grid.Column="1" Background="White" BorderBrush="#DCE1EA" BorderThickness="1,0,0,0" Padding="18">
                <StackPanel>
                    <TextBlock Text="Text properties" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,18"/>
                    <TextBlock Text="Selected text" Foreground="#667085"/>
                    <TextBox Text="{Binding SelectedRegion.DisplayText}" IsReadOnly="True" TextWrapping="Wrap" MinHeight="80" Margin="0,5,0,16"/>
                    <TextBlock Text="Font family" Foreground="#667085"/>
                    <TextBox Text="{Binding SelectedRegion.FontFamily, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,12"/>
                    <TextBlock Text="Font size (pt)" Foreground="#667085"/>
                    <TextBox Text="{Binding SelectedRegion.FontSize, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,10"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <CheckBox Content="Bold" IsChecked="{Binding SelectedRegion.IsBold}" Margin="0,0,16,0"/>
                        <CheckBox Content="Italic" IsChecked="{Binding SelectedRegion.IsItalic}"/>
                    </StackPanel>
                    <Button Content="Apply formatting" Command="{Binding ApplyPropertiesCommand}" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                    <TextBlock Text="Replacement may overflow the original text box." Foreground="#B54708" TextWrapping="Wrap" Margin="0,0,0,8">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedRegion.IsOverflow}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Separator Margin="0,8"/>
                    <TextBlock TextWrapping="Wrap" Foreground="#667085" LineHeight="20"
                               Text="The editor now preserves PDFium-detected font family, size, bold and italic styling where possible. Embedded subset fonts that are not installed in Windows may still require a close fallback font."/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="White" BorderBrush="#DCE1EA" BorderThickness="0,1,0,0" Padding="10,7">
            <DockPanel>
                <ProgressBar Width="120" Height="5" IsIndeterminate="True" DockPanel.Dock="Right">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers><DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>
                <TextBlock Text="{Binding Status}" Foreground="#536078" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
